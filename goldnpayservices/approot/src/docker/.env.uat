# ═══════════════════════════════════════════════════════
#  GoldNPay — UAT environment
#  Used by docker-compose-app.yml and docker-compose-coredb.yml
#  via the scripts in scripts/lstartupscripts (uat-*-up.sh / -down.sh).
#
#  NO SECRETS IN THIS FILE. It is committed to git.
#  Passwords and API keys live in the files that DB_SECRETS_PATH
#  and APP_SECRETS_PATH point to, on the server only.
# ═══════════════════════════════════════════════════════

#Environment
ENV=UAT
NETWORK_NAME=goldnpay-net-uat
GB_NETWORK_NAME=dashboard-net-uat
# Host folder that holds this environment's data (DB files, server logs).
# On Windows/Docker Desktop use a path such as C:/DockerVolumes/goldnpay/uat
PROJECT_VOLUME=/opt/goldnpay/uat
# Secret files on the host (not in git) — only needed for the DB/backend stacks.
DB_SECRETS_PATH=/etc/apps/goldnpay/coreservices/.coredb.secrets.uat
APP_SECRETS_PATH=/etc/apps/goldnpay/coreservices/.coreapp.secrets.uat

#Public URLs (published to the browser as window.env.VITE_*)
# TODO: set the UAT/PRD domain, e.g. https://uat.goldnpay.in
SITE_URL=https://uat.goldnpay.in
# TODO: Core's public URL behind the reverse proxy (e.g. https://api.goldnpay.in). Empty = the app uses no API yet.
API_HOST=

#Client Config
CLIENT_IMAGE_REPO=goldnpay-frontend
# Image version to run. A version passed to the startup script overrides this,
# e.g.  ./uat-app-up.sh 1.0.3
CLIENT_IMAGE_TAG=1.0.0
CLIENT_CONTAINER_NAME=gnp-uat-client
# 0.0.0.0 = reachable from other machines. Use 127.0.0.1 when a reverse proxy
# (nginx/Caddy terminating HTTPS) runs on the same host.
CLIENT_BIND_ADDRESS=0.0.0.0
CLIENT_PORT_EXTERNAL=3061
CLIENT_PORT_INTERNAL=4173

#Core Server Config (GPSCoreServer: users, auth, settings, gold rate, reports)
CORE_IMAGE_REPO=goldnpay-core-server
CORE_IMAGE_TAG=1.0.0
CORE_CONTAINER_NAME=gnp-uat-core
# Holds KYC documents, images and logs. Back this folder up.
CORE_VOLUME=core
# Core is the only backend the reverse proxy exposes; it is bound to the host's loopback.
CORE_BIND_ADDRESS=127.0.0.1
CORE_PORT_EXTERNAL=8221
CORE_PORT_INTERNAL=8080
CORE_LOG_LEVEL=INFO
# Browser origins allowed to call Core (comma separated, no trailing slash).
CORS_ALLOWED_ORIGINS=https://uat.goldnpay.in
KYC_FOLDER=kyc/
IMAGES_VOLUME=images/
HM_IMAGES_VOLUME=homeimages/

#Ops Server Config (GPSOpsServer: email, Telegram, Discord, Twitter, schedulers). Never exposed to the internet.
OPS_IMAGE_REPO=goldnpay-ops-server
OPS_IMAGE_TAG=1.0.0
OPS_CONTAINER_NAME=gnp-uat-ops
OPS_VOLUME=ops
OPS_BIND_ADDRESS=127.0.0.1
OPS_PORT_EXTERNAL=8231
OPS_PORT_INTERNAL=8080
OPS_LOG_LEVEL=INFO

#DB config
MYSQL_IMAGE=mysql:8.4
DB_CONTAINER_NAME=gnp-uat-db
DB_VOLUME=mysql
DB_TIMEZONE=Asia/Kolkata
MYSQL_HOST=gnp-uat-db
MYSQL_SCHEMA=goldnpay_db
MYSQL_PORT_EXTERNAL=3317
MYSQL_PORT_INTERNAL=3306
