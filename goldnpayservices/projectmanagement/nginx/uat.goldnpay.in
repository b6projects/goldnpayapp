# GoldNPay UAT  (docker: gnp-uat-client :3061, gnp-uat-core :8221)
# Initial HTTP-only config; run  setup-goldnpay-nginx.sh --ssl  to let Certbot add HTTPS.
# Same-origin layout (like test.mygoldbucks.com): "/" -> frontend, "/tc/" -> Core API.
# Ops server (:8231) is never exposed.

server {
    listen 80;
    server_name uat.goldnpay.in;

    location / {
        proxy_pass http://127.0.0.1:3061;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Internal service-to-service routes must never be reachable from the internet.
    location ^~ /tc/v1/internal/ {
        return 404;
    }

    # Proxy pass for backend API (Core server)
    location /tc/ {
        proxy_pass http://127.0.0.1:8221;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20m;   # KYC / image uploads
    }

    # Let's Encrypt ACME challenges
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
    }
}
